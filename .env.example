# Copia questo file in .env e compila i valori.
# In sviluppo usare: npm run dev:demo (archivio finto kb-demo/, database Turso).

# ============ SEGRETI — solo qui, mai modificabili da web ============

# --- Accesso web ---
APP_EMAIL=
APP_PASSWORD=
AUTH_SECRET=                       # stringa casuale lunga

# --- Database (Turso) — salva le impostazioni modificabili da /setup ---
TURSO_DATABASE_URL=                # libsql://<db>-<org>.turso.io
TURSO_AUTH_TOKEN=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Google (OAuth, account Gmail della titolare) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=              # da /setup → Collega Google

# --- WhatsApp Cloud API ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=                   # stringa a scelta, uguale nel webhook Meta

# --- Telegram (facoltativo, bot da @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=           # stringa casuale lunga: lettere, numeri, _ e -

# --- Automatismi ---
CRON_SECRET=                       # stringa casuale

# ============ IMPOSTAZIONI — si modificano da /setup (salvate su Turso) ============
# Qui sono facoltative: fanno da valore iniziale. Quello salvato da web ha la precedenza.
# APP_TAGLINE=
# ANTHROPIC_MODEL=claude-sonnet-5
# KB_ROOT_FOLDER_ID=               # impostato da solo con /setup → Crea archivio
# GMAIL_LABEL=                     # vuoto = nome dell'assistente
# GOOGLE_CALENDAR_ID=primary       # ID calendario, modificabile in Impostazioni
# GOOGLE_CALENDAR_MODE=off         # off | read | sync; demo sempre isolata da Google
# WA_ALLOWED_NUMBERS=              # solo cifre con prefisso, separati da virgola
# WA_DIGEST_NUMBERS=               # chi riceve promemoria (vuoto: tutti gli autorizzati)
# TELEGRAM_ALLOWED_CHAT_IDS=       # ID chat private da /start, separati da virgola
# WA_TEMPLATE_DIGEST=eyra_scadenze
# WA_TEMPLATE_AVVISO=eyra_avviso
# WA_TEMPLATE_LANG=it
# REMINDER_DAYS=7,2,0
